<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Trigger IIS AppPool Recycle to load auto_init_admin app.py changes -->
  <system.webServer>
    <handlers>
      <add name="PythonHandler" 
           path="*" 
           verb="*" 
           modules="FastCgiModule" 
           scriptProcessor="C:\Users\monck\AppData\Local\Python\pythoncore-3.14-64\python.exe|C:\Users\monck\AppData\Local\Python\pythoncore-3.14-64\Lib\site-packages\wfastcgi.py" 
           resourceType="Unspecified" 
           requireAccess="Script" />
    </handlers>
  </system.webServer>
  <appSettings>
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\AntiGravity" />
    <add key="WSGI_HANDLER" value="app.app" />
    <add key="WSGI_LOG" value="C:\inetpub\wwwroot\AntiGravity\app.log" />
  </appSettings>
</configuration>
